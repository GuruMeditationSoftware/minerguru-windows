<?xml version="1.0" encoding="utf-8" ?>
<!--
    Power, as the Mac's PowerView: the figures, the own tariff with zones and week bar, the schedules
    that switch the miners, and the costs per miner. Rows are built in code.
-->
<Page
    x:Class="MinerGuru.Pages.PowerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinerGuru.Controls"
    xmlns:local="using:MinerGuru"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="16">

            <controls:AdaptiveGrid
                x:Name="FigureGrid"
                MinColumnWidth="170"
                Spacing="16" />

            <!--  Tariff  -->
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="15"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Glyph="&#xE945;" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="{local:T Key=Tariff}" />
                        </StackPanel>
                        <DropDownButton
                            Grid.Column="1"
                            MinHeight="28"
                            Padding="10,4"
                            Content="{local:T Key=Template}"
                            CornerRadius="6"
                            FontSize="12"
                            ToolTipService.ToolTip="{local:T Key=CreateTypicalZonesThenAdjust}">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Click="DayNightTemplate_Click" Text="{local:T Key=NightAndDayPeakOff}" />
                                    <MenuFlyoutItem Click="WeekendTemplate_Click" Text="{local:T Key=CheaperWeekend}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button AutomationProperties.Name="{local:T Key=CreateATimeZoneWith}"
                            Grid.Column="2"
                            Click="AddZone_Click"
                            Style="{StaticResource SmallButtonStyle}"
                            ToolTipService.ToolTip="{local:T Key=CreateATimeZoneWith}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="{local:T Key=AddZone}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="{local:T Key=Currency}" />
                            <TextBox
                                x:Name="CurrencyBox"
                                AutomationProperties.Name="{local:T Key=Currency}"
                                Width="72"
                                CharacterCasing="Upper"
                                LostFocus="CurrencyBox_LostFocus"
                                MaxLength="3"
                                TextChanged="CurrencyBox_TextChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="BasePriceLabel"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBox
                                x:Name="BasePriceBox"
                                Width="90"
                                LostFocus="BasePriceBox_LostFocus"
                                TextAlignment="Right"
                                TextChanged="BasePriceBox_TextChanged" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ZoneRows" />
                    <TextBlock
                        x:Name="NoZonesText"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{local:T Key=AFixedPriceAppliesAround}"
                        TextWrapping="Wrap" />

                    <controls:WeekTariffBar x:Name="WeekBar" />
                    <StackPanel x:Name="TariffHints" Spacing="4" />
                </StackPanel>
            </Border>

            <!--  Schedules  -->
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="15"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Glyph="&#xE787;" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="{local:T Key=Schedules}" />
                        </StackPanel>
                        <Button AutomationProperties.Name="{local:T Key=SendMinersToNightMode}"
                            x:Name="AddRuleButton"
                            HorizontalAlignment="Right"
                            Click="AddRule_Click"
                            Style="{StaticResource SmallButtonStyle}"
                            ToolTipService.ToolTip="{local:T Key=SendMinersToNightMode}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="{local:T Key=AddSchedule}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="RuleRows" />
                    <TextBlock
                        x:Name="NoRulesText"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{local:T Key=NoSchedulesYetASchedule}"
                        TextWrapping="Wrap" />

                    <Rectangle Height="1" Style="{StaticResource HairlineStyle}" />

                    <controls:AdaptiveGrid MinColumnWidth="380" Spacing="24">
                        <StackPanel Spacing="4">
                            <CheckBox
                                x:Name="RunsSchedulesBox"
                                Click="RunsSchedulesBox_Click"
                                Content="{local:T Key=ThisPCRunsTheSchedules}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="{local:T Key=OnlyOneDeviceShouldSwitch}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="{local:T Key=NightModeFan}" />
                                <NumberBox
                                    x:Name="NightFanBox"
                                    AutomationProperties.Name="{local:T Key=FanInNightModePercent}"
                                    LargeChange="5"
                                    Maximum="100"
                                    Minimum="20"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="NightFanBox_ValueChanged" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="{local:T Key=NightModeLowersTheClock}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:AdaptiveGrid>

                    <StackPanel x:Name="ScheduleError" />
                </StackPanel>
            </Border>

            <!--  Costs per miner  -->
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="15"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Glyph="&#xE950;" />
                        <TextBlock
                            FontSize="15"
                            FontWeight="Medium"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="{local:T Key=CostPerMiner}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="NoMinersText"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{local:T Key=NoMinersYetAddMiners}"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="CostTable" Spacing="8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
