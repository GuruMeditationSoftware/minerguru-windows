<?xml version="1.0" encoding="utf-8" ?>
<!-- Create or edit one saved pool, as the Mac's PoolConfigEditorSheet: template, name, host, port, password, user, latency test. -->
<ContentDialog
    x:Class="MinerGuru.Dialogs.PoolConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MinerGuru"
    CloseButtonText="{local:T De=Abbrechen, En=Cancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <!--  The default 548 leaves 500 for content; the field rows need 520.  -->
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <!--  Headers in the UI font on the mono fields (a header inherits the box's font), on one line so the boxes line up.  -->
        <DataTemplate x:Key="FieldHeader">
            <TextBlock
                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                Text="{Binding}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </ContentDialog.Resources>

    <StackPanel Width="520" Spacing="14">
        <Grid>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="Medium"
                Foreground="{ThemeResource TextPrimaryBrush}" />
            <DropDownButton
                HorizontalAlignment="Right"
                Content="{local:T De='Vorlage…', En='Template…'}"
                Style="{StaticResource DefaultButtonStyle}">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="TemplateMenu" Placement="BottomEdgeAlignedRight" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <TextBox
            x:Name="NameBox"
            Header="Name"
            PlaceholderText="{local:T De='z. B. CKPool EU · rig1', En='e.g. CKPool EU · rig1'}" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="HostBox"
                HeaderTemplate="{StaticResource FieldHeader}"
                FontFamily="{StaticResource MonoFont}"
                Header="{local:T De='Stratum Host / URL (ohne stratum+tcp://)', En='Stratum host / URL (without stratum+tcp://)'}"
                PlaceholderText="public-pool.io"
                TextChanged="Field_Changed" />
            <NumberBox
                x:Name="PortBox"
                Grid.Column="1"
                Header="Port"
                Maximum="65535"
                Minimum="1"
                SpinButtonPlacementMode="Hidden"
                ValueChanged="PortBox_ValueChanged" />
            <TextBox
                x:Name="PasswordBox"
                HeaderTemplate="{StaticResource FieldHeader}"
                Grid.Column="2"
                FontFamily="{StaticResource MonoFont}"
                Header="{local:T De=Passwort, En=Password}"
                PlaceholderText="x" />
        </Grid>

        <TextBox
            x:Name="UserBox"
                HeaderTemplate="{StaticResource FieldHeader}"
            FontFamily="{StaticResource MonoFont}"
            Header="{local:T De='Wallet-Adresse.Worker (Stratum User)', En='Wallet address.worker (stratum user)'}"
            PlaceholderText="bc1q...wallet.bitaxe"
            TextChanged="Field_Changed" />

        <TextBlock
            x:Name="CoinWarningText"
            FontSize="12"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <Grid ColumnSpacing="12">
            <StackPanel
                x:Name="BadgeRow"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12" />
            <Button AutomationProperties.Name="{local:T De='Latenz testen', En='Test latency'}"
                x:Name="TestButton"
                HorizontalAlignment="Right"
                Click="Test_Click"
                Style="{StaticResource SmallButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing
                        x:Name="TestRing"
                        Width="12"
                        Height="12"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <FontIcon FontSize="12" Glyph="&#xE9D9;" />
                    <TextBlock Text="{local:T De='Latenz testen', En='Test latency'}" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>
