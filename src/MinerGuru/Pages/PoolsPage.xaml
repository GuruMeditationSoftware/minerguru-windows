<?xml version="1.0" encoding="utf-8" ?>
<!--
    Pool configuration, as the Mac's PoolConfigurationView: the library of saved pools, then one card per
    miner to put library pools into its slots and send them. The Mac toolbar buttons sit above the library.
-->
<Page
    x:Class="MinerGuru.Pages.PoolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinerGuru.Controls"
    xmlns:local="using:MinerGuru"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="16">

            <!--  Toolbar  -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button AutomationProperties.Name="{local:T De='Alle auf den Minern konfigurierten Pools in die Bibliothek übernehmen', En='Add all pools configured on the miners to the library'}"
                    Click="Import_Click"
                    Style="{StaticResource SmallButtonStyle}"
                    ToolTipService.ToolTip="{local:T De='Alle auf den Minern konfigurierten Pools in die Bibliothek übernehmen', En='Add all pools configured on the miners to the library'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE896;" />
                        <TextBlock Text="{local:T De='Aus Minern auslesen', En='Read from miners'}" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:T De='Neue Pool-Konfiguration anlegen', En='Create a new pool configuration'}"
                    Click="New_Click"
                    Style="{StaticResource SmallButtonStyle}"
                    ToolTipService.ToolTip="{local:T De='Neue Pool-Konfiguration anlegen', En='Create a new pool configuration'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                        <TextBlock Text="{local:T De='Neuer Pool', En='New pool'}" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:T De='Alle geänderten Pool-Zuordnungen senden; die Miner starten danach neu', En='Send all changed pool assignments; the miners restart afterwards'}"
                    x:Name="ApplyAllButton"
                    Click="ApplyAll_Click"
                    Style="{StaticResource SmallAccentButtonStyle}"
                    ToolTipService.ToolTip="{local:T De='Alle geänderten Pool-Zuordnungen senden; die Miner starten danach neu', En='Send all changed pool assignments; the miners restart afterwards'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE73E;" />
                        <TextBlock x:Name="ApplyAllText" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <controls:PoolSchedulesCard />

            <!--  Library  -->
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Glyph="&#xE968;" />
                        <TextBlock
                            FontSize="15"
                            FontWeight="Medium"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="{local:T De=Pool-Bibliothek, En='Pool library'}" />
                        <TextBlock
                            x:Name="LibraryCount"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="11"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="LibraryEmpty"
                        FontSize="13"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{local:T De='Noch keine Pools gespeichert. Lies die Pools deiner Miner aus oder lege einen neuen an.',
                                       En='No pools saved yet. Read the pools from your miners or create a new one.'}"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="LibraryRows" />
                </StackPanel>
            </Border>

            <!--  Assignment  -->
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource SectionTitleStyle}"
                Text="{local:T De='Zuordnung zu Minern', En='Assignment to miners'}" />
            <Border
                x:Name="NoMiners"
                Padding="32"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Glyph="&#xE950;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Text="{local:T De='Keine Miner online', En='No miners online'}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{local:T De='Sobald ein Miner Telemetrie liefert, kannst du hier seine Pool-Slots belegen.',
                                       En='As soon as a miner reports telemetry, you can fill its pool slots here.'}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <controls:AdaptiveGrid
                x:Name="CardGrid"
                MinColumnWidth="440"
                Spacing="16" />
        </StackPanel>
    </ScrollViewer>
</Page>
