<?xml version="1.0" encoding="utf-8" ?>
<!-- Fleet, as the Mac's FleetOverviewView: the solo odds per coin, the fleet card (hashrate, history, boards, key figures), then every miner as a card and the pool table. -->
<Page
    x:Class="MinerGuru.Pages.FleetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinerGuru.Controls"
    xmlns:local="using:MinerGuru"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="32">

            <InfoBar
                x:Name="UpdateBar"
                CloseButtonClick="UpdateBar_CloseButtonClick"
                IsOpen="False"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Click="UpdateDownload_Click" Content="{local:T De='Zum Download', En='Go to download'}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <controls:SupportDevelopmentButton Margin="0,0,0,-24" HorizontalAlignment="Right" />

            <!--  No miners yet  -->
            <Border
                x:Name="EmptyState"
                Margin="0,16,0,0"
                Padding="40"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    Spacing="12">
                    <Border x:Name="EmptyBoardHost" HorizontalAlignment="Center" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SectionTitleStyle}"
                        Text="{local:T De='Noch keine Miner', En='No miners yet'}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{local:T De='Scanne dein lokales Netzwerk oder füge einen Miner direkt per IP-Adresse hinzu.',
                                       En='Scan your local network or add a miner directly by its IP address.'}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Click="Scan_Click"
                            Content="{local:T De='Netzwerk scannen', En='Scan network'}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="Add_Click" Content="{local:T De='Miner hinzufügen', En='Add miner'}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Solo odds per coin  -->
            <StackPanel x:Name="SoloSection" Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{local:T De=Solo-Chancen, En='Solo odds'}" />
                        <TextBlock
                            Style="{StaticResource FigureLabelStyle}"
                            Text="{local:T De='Wahrscheinlichkeit, mit der aktuellen Flotten-Hashrate einen Block zu finden',
                                           En='Probability of finding a block with the current fleet hashrate'}" />
                    </StackPanel>
                    <DropDownButton
                        x:Name="TimeframeButton"
                        Grid.Column="1"
                        MinHeight="28"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        CornerRadius="6"
                        FontSize="12"
                        ToolTipService.ToolTip="{local:T De=Zeitraum, En=Timeframe}">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="TimeframeMenu" Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
                <controls:AdaptiveGrid
                    x:Name="SoloGrid"
                    MinColumnWidth="340"
                    Spacing="16" />
            </StackPanel>

            <!--  Fleet  -->
            <StackPanel x:Name="FleetSection" Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{local:T De=Flotte, En=Fleet}" />
                        <TextBlock x:Name="MetaText" Style="{StaticResource MonoCaptionStyle}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button AutomationProperties.Name="{local:T De='Lokales Netzwerk nach Minern durchsuchen', En='Search the local network for miners'}"
                            Click="Scan_Click"
                            Style="{StaticResource SmallButtonStyle}"
                            ToolTipService.ToolTip="{local:T De='Lokales Netzwerk nach Minern durchsuchen', En='Search the local network for miners'}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE701;" />
                                <TextBlock Text="{local:T De='Netzwerk scannen', En='Scan network'}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{local:T De='IP hinzufügen', En='Add IP'}" Click="Add_Click" Style="{StaticResource SmallButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="{local:T De='IP hinzufügen', En='Add IP'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" CornerRadius="16">
                    <StackPanel>
                        <Grid Padding="24" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="24">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource FigureLabelStyle}" Text="{local:T De=Gesamt-Hashrate, En='Total hashrate'}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="FleetRateValue"
                                            FontSize="44"
                                            Style="{StaticResource FigureValueStyle}" />
                                        <TextBlock
                                            x:Name="FleetRateUnit"
                                            Margin="8,0,0,7"
                                            VerticalAlignment="Bottom"
                                            FontSize="17"
                                            Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="FleetRateSub" Style="{StaticResource MonoCaptionStyle}" />
                                </StackPanel>
                                <controls:HashrateChart x:Name="FleetChart" Height="148" />
                            </StackPanel>
                            <Border
                                x:Name="StackHost"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                VerticalAlignment="Top" />
                        </Grid>
                        <Rectangle Height="1" Style="{StaticResource HairlineStyle}" />
                        <Grid
                            x:Name="FigureStrip"
                            Padding="24,20"
                            ColumnSpacing="0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Miners  -->
            <StackPanel x:Name="MinerSection" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Miner" />
                    <TextBlock
                        x:Name="MinerCountText"
                        Margin="0,0,0,4"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource MonoCaptionStyle}" />
                </StackPanel>
                <controls:AdaptiveGrid
                    x:Name="MinerGrid"
                    MinColumnWidth="340"
                    Spacing="16" />
            </StackPanel>

            <!--  Pool connections of all miners  -->
            <StackPanel x:Name="PoolSection" Spacing="8">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="13"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Glyph="&#xE968;" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{local:T De='Pool-Verbindungen &amp; Latenzen', En='Pool Connections &amp; Latencies'}" />
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{local:T De='Live-Vergleich aller Miner', En='Live comparison of all miners'}" />
                </Grid>
                <controls:PoolOverviewTable x:Name="PoolTable" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
