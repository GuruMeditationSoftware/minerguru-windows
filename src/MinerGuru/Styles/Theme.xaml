<?xml version="1.0" encoding="utf-8" ?>
<!--
    The Mac app's design: one graphite ramp for the surfaces, text in three levels,
    a toned-down Bitcoin orange as the only accent and muted status colors, in light and dark.
    Fonts: Segoe UI Variable stands in for SF Pro, Cascadia Mono for SF Mono (SF may not ship on Windows).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light and dark follow the Windows setting, like the Mac app follows macOS.
        Surfaces (Mac Surface), text in three levels (macOS label colors), accent and signals.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SidebarBrush" Color="#F2F2F3" />
            <SolidColorBrush x:Key="PageBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#EDEDEE" />
            <SolidColorBrush x:Key="InsetBrush" Color="#99EDEDEE" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SelectedStrokeBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14000000" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D9000000" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#80000000" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#42000000" />
            <SolidColorBrush x:Key="AccentBrush" Color="#D9780A" />
            <SolidColorBrush x:Key="ChartAreaBrush" Color="#14D9780A" />
            <SolidColorBrush x:Key="SignalGoodBrush" Color="#14A06C" />
            <SolidColorBrush x:Key="SignalWarningBrush" Color="#C77A00" />
            <SolidColorBrush x:Key="SignalBadBrush" Color="#C23B3B" />
            <SolidColorBrush x:Key="SignalIdleBrush" Color="#8A8A8E" />
            <SolidColorBrush x:Key="WarningStrokeBrush" Color="#80C77A00" />
            <SolidColorBrush x:Key="ButtonFillBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#D9000000" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#80000000" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#42000000" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14000000" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14000000" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SidebarBrush" Color="#0F0F10" />
            <SolidColorBrush x:Key="PageBrush" Color="#141415" />
            <SolidColorBrush x:Key="CardBrush" Color="#19191B" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#232325" />
            <SolidColorBrush x:Key="InsetBrush" Color="#99232325" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SelectedStrokeBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#F0A03C" />
            <SolidColorBrush x:Key="ChartAreaBrush" Color="#14F0A03C" />
            <SolidColorBrush x:Key="SignalGoodBrush" Color="#3ECF8E" />
            <SolidColorBrush x:Key="SignalWarningBrush" Color="#F5B041" />
            <SolidColorBrush x:Key="SignalBadBrush" Color="#E66767" />
            <SolidColorBrush x:Key="SignalIdleBrush" Color="#6E6E73" />
            <SolidColorBrush x:Key="WarningStrokeBrush" Color="#80F5B041" />
            <SolidColorBrush x:Key="ButtonFillBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#141415" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#19191B" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#19191B" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#232325" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SidebarBrush" Color="#0F0F10" />
            <SolidColorBrush x:Key="PageBrush" Color="#141415" />
            <SolidColorBrush x:Key="CardBrush" Color="#19191B" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#232325" />
            <SolidColorBrush x:Key="InsetBrush" Color="#99232325" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SelectedStrokeBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#F0A03C" />
            <SolidColorBrush x:Key="ChartAreaBrush" Color="#14F0A03C" />
            <SolidColorBrush x:Key="SignalGoodBrush" Color="#3ECF8E" />
            <SolidColorBrush x:Key="SignalWarningBrush" Color="#F5B041" />
            <SolidColorBrush x:Key="SignalBadBrush" Color="#E66767" />
            <SolidColorBrush x:Key="SignalIdleBrush" Color="#6E6E73" />
            <SolidColorBrush x:Key="WarningStrokeBrush" Color="#80F5B041" />
            <SolidColorBrush x:Key="ButtonFillBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#141415" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#19191B" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#19191B" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#232325" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  Accent: the orange instead of the Windows accent  -->
    <Color x:Key="SystemAccentColor">#E8890F</Color>
    <Color x:Key="SystemAccentColorLight1">#F0A03C</Color>
    <Color x:Key="SystemAccentColorLight2">#F5B866</Color>
    <Color x:Key="SystemAccentColorLight3">#F9D199</Color>
    <Color x:Key="SystemAccentColorDark1">#D9780A</Color>
    <Color x:Key="SystemAccentColorDark2">#B5620A</Color>
    <Color x:Key="SystemAccentColorDark3">#8C4B08</Color>

    <!--  Type  -->
    <FontFamily x:Key="FigureFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!--  Mac Font.mono(11), tertiary: meta lines, axes, counts, addresses  -->
    <Style x:Key="MonoCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!--  Label above a figure: 12, secondary  -->
    <Style x:Key="FigureLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  Mac Font.figure: medium; the size is set where it is used  -->
    <Style x:Key="FigureValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FigureFont}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="FigureUnitStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="5,0,0,0" />
    </Style>

    <!--  Section title: 20, medium  -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FigureFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <!--  Card: card surface with a hairline, radius 14 (Mac nativeCard)  -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!--  Inset inside a card, e.g. the pool line  -->
    <Style x:Key="InsetBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource InsetBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="HairlineStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource HairlineBrush}" />
    </Style>

    <!--  Small bordered button as in the Mac section headers  -->
    <Style
        x:Key="SmallButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--  Small accent button for the main action of a card  -->
    <Style
        x:Key="SmallAccentButtonStyle"
        BasedOn="{StaticResource AccentButtonStyle}"
        TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--  Borderless button of the sidebar bar: 12, secondary  -->
    <Style
        x:Key="BarButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <!--  Page geometry (Mac PageLayout)  -->
    <x:Double x:Key="PageMaxWidth">1280</x:Double>
    <Thickness x:Key="PagePadding">20,8,20,24</Thickness>
</ResourceDictionary>
