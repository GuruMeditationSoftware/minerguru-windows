<?xml version="1.0" encoding="utf-8" ?>
<!--
    Pool configuration, as the Mac's PoolConfigurationView: the library of saved pools, then one card per
    miner to put library pools into its slots and send them. The Mac toolbar buttons sit above the library.
-->
<Page
    x:Class="MinerGuru.Pages.PoolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinerGuru.Controls"
    xmlns:local="using:MinerGuru"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="16">

            <!--  Toolbar  -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button AutomationProperties.Name="{local:T Key=AddAllPoolsConfiguredOn}"
                    Click="Import_Click"
                    Style="{StaticResource SmallButtonStyle}"
                    ToolTipService.ToolTip="{local:T Key=AddAllPoolsConfiguredOn}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE896;" />
                        <TextBlock Text="{local:T Key=ReadFromMiners}" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:T Key=CreateANewPoolConfiguration}"
                    Click="New_Click"
                    Style="{StaticResource SmallButtonStyle}"
                    ToolTipService.ToolTip="{local:T Key=CreateANewPoolConfiguration}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                        <TextBlock Text="{local:T Key=NewPool}" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:T Key=SendAllChangedPoolAssignments}"
                    x:Name="ApplyAllButton"
                    Click="ApplyAll_Click"
                    Style="{StaticResource SmallAccentButtonStyle}"
                    ToolTipService.ToolTip="{local:T Key=SendAllChangedPoolAssignments}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE73E;" />
                        <TextBlock x:Name="ApplyAllText" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <controls:PoolSchedulesCard />

            <!--  Library  -->
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Glyph="&#xE968;" />
                        <TextBlock
                            FontSize="15"
                            FontWeight="Medium"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="{local:T Key=PoolLibrary}" />
                        <TextBlock
                            x:Name="LibraryCount"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="11"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="LibraryEmpty"
                        FontSize="13"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{local:T Key=NoPoolsSavedYetRead}"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="LibraryRows" />
                </StackPanel>
            </Border>

            <!--  Assignment  -->
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource SectionTitleStyle}"
                Text="{local:T Key=AssignmentToMiners}" />
            <Border
                x:Name="NoMiners"
                Padding="32"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Glyph="&#xE950;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Text="{local:T Key=NoMinersOnline}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{local:T Key=AsSoonAsAMiner}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <controls:AdaptiveGrid
                x:Name="CardGrid"
                MinColumnWidth="440"
                Spacing="16" />
        </StackPanel>
    </ScrollViewer>
</Page>
