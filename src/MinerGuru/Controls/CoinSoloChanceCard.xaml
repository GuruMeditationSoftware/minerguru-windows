<?xml version="1.0" encoding="utf-8" ?>
<!--
    Solo-mining odds for one coin, as the Mac's CoinSoloChanceCard: coin and fleet hashrate on top,
    the odds next to the block reward, the contributing miners and the network difficulty in an inset.
-->
<UserControl
    x:Class="MinerGuru.Controls.CoinSoloChanceCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MinerGuru">

    <Border Padding="20" Style="{StaticResource CardBorderStyle}">
        <StackPanel Spacing="16">
            <!--  Coin and the fleet hashrate on it  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    x:Name="CoinDot"
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="CoinName"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock
                    x:Name="CoinSymbol"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource MonoCaptionStyle}" />
                <TextBlock
                    x:Name="RateText"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Style="{StaticResource MonoCaptionStyle}" />
            </Grid>

            <!--  Odds | block reward  -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource FigureLabelStyle}" Text="{local:T Key=SoloChance}" />
                    <Viewbox
                        x:Name="OddsBox"
                        Height="40"
                        HorizontalAlignment="Left"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                        <TextBlock
                            x:Name="OddsText"
                            FontSize="32"
                            Style="{StaticResource FigureValueStyle}" />
                    </Viewbox>
                    <TextBlock x:Name="PercentText" Style="{StaticResource MonoCaptionStyle}" />
                    <TextBlock x:Name="BlockTimeText" Style="{StaticResource MonoCaptionStyle}" />
                </StackPanel>
                <Rectangle
                    Grid.Column="1"
                    Height="88"
                    VerticalAlignment="Top"
                    Style="{StaticResource HairlineStyle}" />
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Style="{StaticResource FigureLabelStyle}" Text="{local:T Key=BlockReward}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock
                            x:Name="RewardValue"
                            FontSize="20"
                            Style="{StaticResource FigureValueStyle}" />
                        <TextBlock
                            x:Name="RewardUnit"
                            Margin="4,0,0,2"
                            VerticalAlignment="Bottom"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Text="{local:T Key=ExcludingTransactionFees}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!--  Contributing miners and network difficulty  -->
            <Border
                Height="32"
                Padding="12,0"
                Style="{StaticResource InsetBorderStyle}">
                <Grid VerticalAlignment="Center" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MinersText" Style="{StaticResource MonoCaptionStyle}" />
                    <TextBlock
                        x:Name="DifficultyText"
                        Grid.Column="1"
                        Style="{StaticResource MonoCaptionStyle}" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
