<?xml version="1.0" encoding="utf-8" ?>
<!-- Settings in the Windows settings style: one card per setting, the control on the right. -->
<Page
    x:Class="MinerGuru.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinerGuru.Controls"
    xmlns:local="using:MinerGuru"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <TextBlock
                Margin="0,0,0,20"
                Style="{StaticResource SectionTitleStyle}"
                Text="{local:T Key=Settings}" />

            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=General}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{local:T Key=InterfaceLanguage}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=TakesEffectAfterRestartingMinerGuru}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LanguageBox"
                        AutomationProperties.Name="{local:T Key=InterfaceLanguage}"
                        Grid.Column="2"
                        SelectionChanged="LanguageBox_SelectionChanged" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7B3;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{local:T Key=PrivacyMode}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=HidesIPWalletAndMAC}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:T Key=PrivacyMode}"
                        x:Name="PrivacySwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="PrivacySwitch_Toggled" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=Polling}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE916;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=PollingInterval}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=HowOftenMinerGuruAsksEvery}" />
                    </StackPanel>
                    <NumberBox AutomationProperties.Name="{local:T Key=PollingInterval}"
                        x:Name="IntervalBox"
                        Grid.Column="2"
                        Width="140"
                        Maximum="300"
                        Minimum="2"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="IntervalBox_ValueChanged" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=NetworkScan}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE968;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=DefaultSubnet24}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=TheFirstThreePartsOf}" />
                    </StackPanel>
                    <TextBox AutomationProperties.Name="{local:T Key=DefaultSubnet24}"
                        x:Name="SubnetBox"
                        Grid.Column="2"
                        Width="140"
                        FontFamily="{StaticResource MonoFont}"
                        LostFocus="SubnetBox_LostFocus" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE701;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{local:T Key=ScanAutomaticallyAtStartupWhen}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch AutomationProperties.Name="{local:T Key=ScanAutomaticallyAtStartupWhen}"
                        x:Name="AutoScanSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="AutoScanSwitch_Toggled" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=BlockView}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" Glyph="&#xE7B8;" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{local:T Key=AskThePoolForThe}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=ForMinersThatDoNot}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=NoSharesAreSubmittedOn}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:T Key=AskThePoolForThe}"
                        x:Name="StratumProbeSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Top"
                        OffContent=""
                        OnContent=""
                        Toggled="StratumProbeSwitch_Toggled" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=Warnings}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9CA;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=TemperatureWarningFrom}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=MinersAboveThisASICTemperature}" />
                    </StackPanel>
                    <NumberBox AutomationProperties.Name="{local:T Key=TemperatureWarningFrom}"
                        x:Name="TempBox"
                        Grid.Column="2"
                        Width="140"
                        Maximum="95"
                        Minimum="40"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="TempBox_ValueChanged" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA8F;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=NotifyAboutProblems}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=AlarmsOnlyNoAdvertisingKeeps}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:T Key=NotifyAboutProblems}"
                        x:Name="AlertsSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="AlertsSwitch_Toggled" />
                </Grid>
            </Border>
            <Border x:Name="OfflineAlertCard" Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE968;" />
                    <TextBlock
                        x:Name="OfflineAlertText"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Name="OfflineAlertSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="OfflineAlertSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE90F;" />
                    <TextBlock
                        x:Name="MaintenanceAlertText"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Name="MaintenanceAlertSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="MaintenanceAlertSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" />
                    <TextBlock
                        x:Name="OverheatAlertText"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Name="OverheatAlertSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="OverheatAlertSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" />
                    <TextBlock
                        x:Name="FlatlineAlertText"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Name="FlatlineAlertSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="FlatlineAlertSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8AB;" />
                    <TextBlock
                        x:Name="FallbackAlertText"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Name="FallbackAlertSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="FallbackAlertSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE777;" />
                    <TextBlock
                        x:Name="RestartAlertText"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Name="RestartAlertSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="RestartAlertSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C7;" />
                    <TextBlock
                        x:Name="PayoutAlertText"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Name="PayoutAlertSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="PayoutAlertSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE715;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{local:T Key=EmailAlerts}" />
                        <TextBlock x:Name="EmailStatusText" Style="{StaticResource MonoCaptionStyle}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Click="EmailAlerts_Click"
                        Content="{local:T Key=SetUp}" />
                </Grid>
            </Border>

            <StackPanel x:Name="WidgetsSection">
                <TextBlock
                    Margin="0,20,0,8"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Widgets" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF246;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="WidgetsTitle" Text="{local:T Key=WidgetsOnTheWidgetBoard}" />
                            <TextBlock
                                x:Name="WidgetsHint"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <HyperlinkButton
                                x:Name="DeveloperSettingsLink"
                                Margin="-12,0,0,0"
                                Click="DeveloperSettings_Click"
                                Content="{local:T Key=OpenWindowsSettingsForDevelopers}" />
                        </StackPanel>
                        <ToggleSwitch AutomationProperties.Name="{local:T Key=WidgetsOnTheWidgetBoard}"
                            x:Name="WidgetsSwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="WidgetsSwitch_Toggled" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=NotificationArea}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8FC;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=KeepRunningInTheNotification}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=MonitoringAndSchedulesKeepRunning}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:T Key=KeepRunningInTheNotification}"
                        x:Name="KeepRunningSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="KeepRunningSwitch_Toggled" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Updates" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=CheckForNewVersionsDaily}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{local:T Key=MinerGuruAsksGitHubForThe}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:T Key=CheckForNewVersionsDaily}"
                        x:Name="UpdateCheckSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="UpdateCheckSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Margin="0,4,0,0" Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72C;" />
                    <TextBlock
                        x:Name="UpdateStatusText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        x:Name="UpdateDownloadLink"
                        Grid.Column="2"
                        Click="UpdateDownload_Click"
                        Content="{local:T Key=GoToDownload}" />
                    <Button
                        x:Name="UpdateCheckButton"
                        Grid.Column="3"
                        Click="UpdateCheckButton_Click"
                        Content="{local:T Key=CheckNow}" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=Data}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=DataFolder}" />
                        <TextBlock
                            x:Name="DataFolderText"
                            Style="{StaticResource MonoCaptionStyle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Click="OpenFolder_Click"
                        Content="{local:T Key=OpenInExplorer}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=DiagnosticLog}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            Text="{local:T Key=RecordsStatesAlertsSwitchingAnd}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Click="ExportLog_Click"
                        Content="{local:T Key=Export}" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=ExpectedAddresses}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="10">
                    <TextBox
                        x:Name="BtcAddressBox"
                        Header="Bitcoin"
                        LostFocus="AddressBox_LostFocus" />
                    <TextBox
                        x:Name="BchAddressBox"
                        Header="Bitcoin Cash"
                        LostFocus="AddressBox_LostFocus" />
                    <TextBox
                        x:Name="DgbAddressBox"
                        Header="DigiByte"
                        LostFocus="AddressBox_LostFocus" />
                    <TextBox
                        x:Name="XecAddressBox"
                        Header="eCash"
                        LostFocus="AddressBox_LostFocus" />
                    <TextBlock
                        x:Name="AddressWarning"
                        Foreground="{ThemeResource SignalBadBrush}"
                        Text="{local:T Key=ThisIsNotAValid}"
                        Visibility="Collapsed" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.7"
                        Text="{local:T Key=MinerGuruWarnsWhenAMiner}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=Interventions}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=ReadOnly}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            Text="{local:T Key=ChangeNothingOnMiners}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:T Key=ReadOnly}"
                        x:Name="ReadOnlySwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="ReadOnlySwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72C;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=RestartWithoutShares}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            Text="{local:T Key=AtMostOnceAnHour}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:T Key=RestartWithoutShares}"
                        x:Name="RestartFlatlineSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="RestartFlatlineSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72C;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T Key=BringBackToPrimaryPool}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            Text="{local:T Key=AtMostOnceAnHour}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:T Key=BringBackToPrimaryPool}"
                        x:Name="RestartPrimarySwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="RestartPrimarySwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE81C;" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{local:T Key=ChangeLog}" />
                    <Button
                        Grid.Column="2"
                        Click="ChangeLog_Click"
                        Content="{local:T Key=Show}" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{local:T Key=About}" />
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="32"
                        Height="32"
                        Source="ms-appx:///Assets/AppIcon.ico" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MinerGuru" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource MonoCaptionStyle}" />
                        <TextBlock Style="{StaticResource MonoCaptionStyle}" Text="Made by GuruMeditation" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Spacing="4">
                <controls:SupportDevelopmentButton />
                <HyperlinkButton Click="Feedback_Click" Content="{local:T Key=SendFeedback}" FontSize="12" />
                <HyperlinkButton Click="License_Click" Content="{local:T Key=License}" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
