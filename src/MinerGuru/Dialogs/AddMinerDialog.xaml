<?xml version="1.0" encoding="utf-8" ?>
<!-- Add a miner by address: checks the connection first, and still allows adding one that is off right now. -->
<ContentDialog
    x:Class="MinerGuru.Dialogs.AddMinerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MinerGuru"
    Title="{local:T Key=AddMiner}"
    CloseButtonText="{local:T Key=Cancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    PrimaryButtonText="{local:T Key=Add}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Width="420" Spacing="16">
        <TextBox
            x:Name="AddressBox"
            Header="{local:T Key=IPAddressOrHostname}"
            PlaceholderText="192.168.1.50"
            TextChanged="AddressBox_TextChanged" />
        <TextBox
            x:Name="NameBox"
            Header="{local:T Key=NameOptional}"
            PlaceholderText="{local:T Key=TheMinerHostname}" />
        <InfoBar
            x:Name="ResultBar"
            IsClosable="False"
            IsOpen="False" />
        <ProgressBar
            x:Name="Progress"
            IsIndeterminate="True"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
